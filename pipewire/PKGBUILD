  pipewire-alsa
  pipewire-audio
  pipewire-jack
  pipewire-jack-client
  pipewire-pulse
  pipewire-session-manager
  pulseaudio
)
install=pipewire.install
source=(
  "git+https://gitlab.freedesktop.org/pipewire/pipewire.git#tag=$pkgver"
)
b2sums=('d4f511e99af6bed1ec132f2faff8225e1c61c20a9654b14a4b8c485989cab394a09a3a4c7ce53c42ef6eaf56b86bab7a03abefb147e9eb08ca6d7464f0d7c50c')

build() {
  # NOTE: verify all feature options against pipewire/meson_options.txt
  # for the exact tagged release before adding new ones — HEAD and tag can differ.
  local meson_options=(
    -D bluez5=disabled
    -D docs=disabled
    -D gstreamer=disabled
    -D jack-devel=true
    -D libcamera=disabled
    -D libjack-path=/usr/lib
    -D lv2=disabled
    -D man=disabled
    -D rlimits-install=false
    -D roc=disabled
    -D selinux=disabled
    -D session-managers=[]
    -D snap=disabled
    -D sdl2=disabled
    -D udevrulesdir=/usr/lib/udev/rules.d
    -D v4l2=disabled
    -D x11=disabled
    -D x11-xfixes=disabled
    -D libcanberra=disabled
    -D gstreamer-device-provider=disabled
    -D libffado=disabled
    -D jack=disabled
    -D libmysofa=disabled
    -D ebur128=disabled
    -D onnxruntime=disabled
  )

  arch-meson pipewire build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  cd "$pkgdir"

  # Replace copies with symlinks
  for _f in pipewire-{aes67,avb,pulse}; do
    cmp usr/bin/pipewire usr/bin/$_f
    ln -sf pipewire usr/bin/$_f
  done

  # ALSA configuration symlinks (from former pipewire-audio + pipewire-alsa)
  mkdir -p etc/alsa/conf.d
  ln -st etc/alsa/conf.d \
    /usr/share/alsa/alsa.conf.d/50-pipewire.conf \
    /usr/share/alsa/alsa.conf.d/99-pipewire-default.conf

  # Session manager markers
  install -Dm644 /dev/null usr/share/pipewire/media-session.d/with-alsa
  install -Dm644 /dev/null usr/share/pipewire/media-session.d/with-jack
  install -Dm644 /dev/null usr/share/pipewire/media-session.d/with-pulseaudio

  # Config override directories
  mkdir -p etc/pipewire/{client-rt,client,jack,minimal,pipewire,pipewire-pulse}.conf.d

  install -Dt usr/share/licenses/$pkgname -m644 "$srcdir/pipewire/COPYING"
}
