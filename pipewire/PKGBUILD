pkgname=pipewire
pkgver=1.6.8
pkgrel=1
epoch=2
pkgdesc="Low-latency audio/video router and processor"
url="https://pipewire.org"
arch=(x86_64)
license=(MIT LGPL-2.1-or-later GPL-2.0-only)
makedepends=(
  alsa-lib
  avahi
  dbus
  git
  glib2
  glib2-devel
  libpulse
  libstdc++
  libusb
  meson
  ncurses
  opus
  readline
  rtkit
  systemd
)
depends=(
  alsa-lib libasound.so
  avahi libavahi-{client,common}.so
  dbus libdbus-1.so
  dconf
  glib2 libg{lib,object,io}-2.0.so
  glibc
  libgcc
  libpulse libpulse.so
  libstdc++
  libusb libusb-1.0.so
  ncurses libncursesw.so
  opus libopus.so
  readline libreadline.so
  sh
  systemd-libs libsystemd.so libudev.so
  wireplumber
)
optdepends=(
  'realtime-privileges: realtime privileges with rt module'
  'rtkit: realtime privileges with rtkit module'
)
provides=(
  jack
  ladspa-host
  libpipewire
  libpipewire-0.3.so
  libjack.so
  libjacknet.so
  libjackserver.so
  pipewire-alsa
  pipewire-audio
  pipewire-jack
  pipewire-pulse
  pulse-native-provider
  pipewire-session-manager
)
conflicts=(
  alsa-card-profiles
  jack
  jack2
  libpipewire
  pipewire-alsa
  pipewire-audio
  pipewire-jack
  pipewire-jack-client
  pipewire-pulse
  pulseaudio
)
install=pipewire.install
source=(
  "git+https://gitlab.freedesktop.org/pipewire/pipewire.git#tag=$pkgver"
)
b2sums=('f4425c8fa9ab33918e52bb0c1272079dd510e1c08b1d228802ad60e7080629f1e82ec30f19dd9e344cd6476803773d79f50957ddfeecfc01d657550a712fd6ba')

build() {
  local meson_options=(
    -D bluez5=disabled
    -D docs=disabled
    -D gstreamer=disabled
    -D jack-devel=true
    -D libcamera=disabled
    -D libjack-path=/usr/lib
    -D lv2=disabled
    -D man=disabled
    -D rlimits-install=false
    -D roc=disabled
    -D selinux=disabled
    -D session-managers=[]
    -D snap=disabled
    -D sdl2=disabled
    -D udevrulesdir=/usr/lib/udev/rules.d
    -D v4l2=disabled
    -D x11=disabled
    -D x11-xfixes=disabled
    -D libcanberra=disabled
    -D gstreamer-device-provider=disabled
    -D libffado=disabled
    -D jack=disabled
    -D libmysofa=disabled
    -D ebur128=disabled
    -D onnxruntime=disabled
    -D echo-cancel-webrtc=disabled
    -D sndfile=disabled
    -D pw-cat=disabled
    -D fftw=disabled
  )

  arch-meson pipewire build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  cd "$pkgdir"

  # Replace copies with symlinks
  for _f in pipewire-{aes67,avb,pulse}; do
    cmp usr/bin/pipewire usr/bin/$_f
    ln -sf pipewire usr/bin/$_f
  done

  # ALSA configuration symlinks (from former pipewire-audio + pipewire-alsa)
  mkdir -p etc/alsa/conf.d
  ln -st etc/alsa/conf.d \
    /usr/share/alsa/alsa.conf.d/50-pipewire.conf \
    /usr/share/alsa/alsa.conf.d/99-pipewire-default.conf

  # Session manager markers
  install -Dm644 /dev/null usr/share/pipewire/media-session.d/with-alsa
  install -Dm644 /dev/null usr/share/pipewire/media-session.d/with-jack
  install -Dm644 /dev/null usr/share/pipewire/media-session.d/with-pulseaudio

  # Config override directories
  mkdir -p etc/pipewire/{client-rt,client,jack,minimal,pipewire,pipewire-pulse}.conf.d

  install -Dt usr/share/licenses/$pkgname -m644 "$srcdir/pipewire/COPYING"
}
