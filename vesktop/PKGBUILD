pkgname=vesktop
pkgver=1.6.4
pkgrel=1
pkgdesc="A standalone Electron-based Discord app with Vencord & improved Linux support"
arch=('x86_64' 'aarch64')
url="https://github.com/Vencord/Vesktop"
license=('GPL-3.0-only')
depends=('alsa-lib' 'gtk3' 'nss')
makedepends=('nodejs' 'pnpm')
optdepends=(
  'libnotify: desktop notifications'
  'xdg-utils: open links and files'
)
options=(!strip)
source=(
  "$pkgname-$pkgver.tar.gz::https://github.com/Vencord/Vesktop/archive/v$pkgver.tar.gz"
  "$pkgname.desktop"
  "$pkgname.sh"
)

sha256sums=(
  'SKIP'
  '98fa8f661b065c2d825e24f0055a40ae01d58d23628ad7ebf6914296209dd43c'
  '506c246328af639d6f6a3e52215c7b34af2a6df11d195de6f57a8bbee750cce9'
)

build() {
  cd "$srcdir/Vesktop-$pkgver"
  pnpm install --frozen-lockfile
  pnpm package:dir
}

package() {
  cd "$srcdir/Vesktop-$pkgver"

  install -d "$pkgdir/usr/lib/$pkgname"
  cp -r dist/linux-unpacked/* "$pkgdir/usr/lib/$pkgname"

  install -Dm755 "$srcdir/$pkgname.sh" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$srcdir/$pkgname.desktop" \
    "$pkgdir/usr/share/applications/$pkgname.desktop"

  install -Dm644 build/icon.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"

  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
