# Maintainer: VolRen <VolRencs@proton.me>

pkgname=vesktop
pkgver=1.6.1
pkgrel=1
pkgdesc="A standalone Electron-based Discord app with Vencord & improved Linux support"
arch=('x86_64')
url="https://github.com/Vencord/Vesktop"
license=('GPL-3.0-only')
depends=('alsa-lib' 'gtk3' 'nss')
makedepends=('pnpm' 'nodejs' 'npm')
optdepends=(
  'libnotify: Notifications'
  'xdg-utils: Open links, files, etc'
)
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/Vencord/Vesktop/archive/v${pkgver}.tar.gz"
  "vesktop.desktop"
  "vesktop.sh"
)
sha256sums=('ba103cf8a9edef31eb78c1bc3d76e40151f84ff02b2da8fd2bc21a954841b523'
            '683982d9c5fc05ec48913c206096bd71a9cb87e01e6f882fe51ac1e808e9a15c'
            '506c246328af639d6f6a3e52215c7b34af2a6df11d195de6f57a8bbee750cce9')

build() {
  cd "${srcdir}/Vesktop-${pkgver}"
  pnpm install --frozen-lockfile
  pnpm run package:dir
}

package() {
  cd "${srcdir}/Vesktop-${pkgver}"

  install -d "${pkgdir}/usr/lib/${pkgname}"
  cp -r dist/linux-unpacked/* "${pkgdir}/usr/lib/${pkgname}/"

  if [ -f "${pkgdir}/usr/lib/${pkgname}/electron" ]; then
    mv "${pkgdir}/usr/lib/${pkgname}/electron" "${pkgdir}/usr/lib/${pkgname}/vesktop"
  fi

  install -Dm644 "../vesktop.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"

  install -Dm644 "build/icon.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${pkgname}.svg"

  install -Dm755 "../vesktop.sh" "${pkgdir}/usr/bin/${pkgname}"
}
