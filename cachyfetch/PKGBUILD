# Maintainer: VolRen <VolRencs@proton.me>

pkgname=cachyfetch
pkgver=1.0.0
pkgrel=1
pkgdesc="A fast system info fetcher written in Zig, made for CachyOS"
arch=('x86_64')
url="https://github.com/VolRencs/cachyfetch"
license=('MIT')
makedepends=('zig')
optdepends=(
    'pciutils: GPU name detection via lspci'
    'nvidia-utils: NVIDIA GPU name via nvidia-smi'
    'xorg-xrandr: monitor detection on X11'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    zig build -Doptimize=ReleaseFast -Dtarget=x86_64-linux -Dcpu=baseline
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 zig-out/bin/$pkgname "$pkgdir/usr/bin/$pkgname"
}
