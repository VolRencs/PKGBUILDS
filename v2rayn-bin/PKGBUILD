pkgname="v2rayn-bin"
pkgver=1.0.0
pkgrel=1
epoch=1
pkgdesc="A GUI client for Windows and Linux, support Xray core and others"
arch=("x86_64")
license=("GPL-3.0-only")
url="https://github.com/2dust/v2rayN"
options=("!strip")

source=(
  "v2rayN-linux-64-${pkgver}.zip::https://github.com/VolRencs/v2rayN/releases/download/${pkgver}/v2rayN-linux-64.zip"
  "v2rayn.svg"
  "v2rayn-bin.desktop"
)
sha256sums=(
  "2f4f089f4b37b338b315ab87e2f7563f13571b05d8903959aac06b09b87df8d0"
  "SKIP"
  "SKIP"
)

package() {
  local _install_dir="${pkgdir}/opt/${pkgname}"

  install -Dm644 "${srcdir}/v2rayn.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/v2rayN.svg"
  install -Dm644 "${srcdir}/v2rayn-bin.desktop"  "${pkgdir}/usr/share/applications/v2rayn-bin.desktop"

  install -dm755 "${_install_dir}"
  cp -a "${srcdir}/v2rayN-linux-64/." "${_install_dir}/"

  find "${_install_dir}" -type f ! -name "v2rayN" -exec chmod 644 {} +
  chmod 755 "${_install_dir}/v2rayN"

  install -dm755 "${pkgdir}/usr/bin"
  ln -s "/opt/${pkgname}/v2rayN" "${pkgdir}/usr/bin/v2rayn"
}
