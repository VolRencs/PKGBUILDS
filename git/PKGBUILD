pkgbase=git
pkgname=git
pkgver=2.54.0
pkgrel=1
epoch=1
pkgdesc='the fast distributed version control system'
arch=('x86_64')
url='https://git-scm.com/'
license=('GPL-2.0-only')
depends=('curl'
         'expat'
         'openssl'
         'pcre2'
         'grep'
         'shadow'
         'zlib-ng')
makedepends=('python'
             'git'
             'rust'
             'meson'
             'ninja')
checkdepends=('openssh')
install=git.install
source=("git+https://github.com/git/git#tag=v${pkgver}"
        'git-daemon@.service'
        'git-daemon.socket'
        'git-sysusers.conf')
sha256sums=('a185bb4716fe77d02d8cf81080686c580fece76e0289593871810c83f2c912a1'
            '14c0b67cfe116b430645c19d8c4759419657e6809dfa28f438c33a005245ad91'
            'ac4c90d62c44926e6d30d18d97767efc901076d4e0283ed812a349aece72f203'
            '7630e8245526ad80f703fac9900a1328588c503ce32b37b9f8811674fcda4a45')

build() {
  cd "$pkgbase"
  meson setup build \
    --prefix=/usr \
    --libexecdir=/usr/lib/git-core \
    --buildtype=release \
    --strip \
    -Dperl=disabled \
    -Dgitweb=disabled \
    -Dtests=false \
    -Ddocs=[] \
    -Dpcre2=enabled \
    -Dzlib_backend=zlib-ng \
    -Dcurl=enabled \
    -Dexpat=enabled \
    -Drust=enabled \
    -Dcontrib=completion,subtree \
    -Dcredential_helpers=libsecret
  meson compile -C build
}

package_git() {
  cd "$pkgbase"
  DESTDIR="$pkgdir" meson install -C build

  local main="$pkgdir/usr/lib/git-core/git"
  find "$pkgdir/usr/lib/git-core/" -type f ! -name 'git' | while read -r f; do
    if cmp -s "$f" "$main"; then
      ln -sf git "$f"
    fi
  done

  install -Dm644 "$srcdir/git-daemon@.service" \
    "$pkgdir/usr/lib/systemd/system/git-daemon@.service"
  install -Dm644 "$srcdir/git-daemon.socket" \
    "$pkgdir/usr/lib/systemd/system/git-daemon.socket"
  install -Dm644 "$srcdir/git-sysusers.conf" \
    "$pkgdir/usr/lib/sysusers.d/git.conf"
}

