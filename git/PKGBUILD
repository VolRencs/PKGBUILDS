pkgbase=git
pkgname=git
pkgver=2.53.0
pkgrel=1
epoch=1
pkgdesc='the fast distributed version control system'
arch=('x86_64')
url='https://git-scm.com/'
license=('GPL-2.0-only')
depends=('curl'
         'expat'
         'openssl'
         'pcre2'
         'grep'
         'shadow'
         'zlib-ng')
makedepends=('python'
             'xmlto'
             'asciidoc'
             'git'
             'rust'
             'meson'
             'ninja')
checkdepends=('openssh')
install=git.install
source=("git+https://github.com/git/git#tag=v${pkgver}"
        'git-daemon@.service'
        'git-daemon.socket'
        'git-sysusers.conf')
sha256sums=('9a01c7ee4b1d39392b1f0216c2548f3de1805bed6976140b0509f24751de0a6f'
            '14c0b67cfe116b430645c19d8c4759419657e6809dfa28f438c33a005245ad91'
            'ac4c90d62c44926e6d30d18d97767efc901076d4e0283ed812a349aece72f203'
            '7630e8245526ad80f703fac9900a1328588c503ce32b37b9f8811674fcda4a45')

build() {
  cd "$pkgbase"

  meson setup build \
    --prefix=/usr \
    --libexecdir=/usr/lib/git-core \
    -Dc_args="-Wno-discarded-qualifiers" \
    --buildtype=release \
    -Dperl=disabled \
    -Dgitweb=disabled \
    -Dtests=false \
    -Dbenchmarks=disabled \
    -Ddocs=man \
    -Dpcre2=enabled \
    -Dzlib_backend=zlib-ng \
    -Dcurl=enabled \
    -Dexpat=enabled \
    -Drust=enabled

  meson compile -C build
}


package_git() {
  cd "$pkgbase"

  DESTDIR="$pkgdir" meson install -C build

  install -Dm644 contrib/completion/git-completion.bash \
    "$pkgdir/usr/share/bash-completion/completions/git"

  install -Dm644 contrib/completion/git-prompt.sh \
    "$pkgdir/usr/share/git/git-prompt.sh"

  find contrib/ -name '.gitignore' -delete
  cp -a contrib/* "$pkgdir/usr/share/git/"

  install -Dm644 "$srcdir/git-daemon@.service" \
    "$pkgdir/usr/lib/systemd/system/git-daemon@.service"

  install -Dm644 "$srcdir/git-daemon.socket" \
    "$pkgdir/usr/lib/systemd/system/git-daemon.socket"

  install -Dm644 "$srcdir/git-sysusers.conf" \
    "$pkgdir/usr/lib/sysusers.d/git.conf"
}

