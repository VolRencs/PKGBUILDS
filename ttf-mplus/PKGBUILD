# Maintainer: VolRen <VolRencs@proton.me>

pkgbase=ttf-mplus
pkgname=(
    ttf-mplus1
    ttf-mplus2
)
pkgver=1.0.0
pkgrel=1
pkgdesc='Modern M+ Japanese font family'
arch=('any')
url='https://github.com/coz-m/MPLUS_FONTS'
license=('OFL-1.1')
makedepends=('git')
source=('git+https://github.com/coz-m/MPLUS_FONTS.git')
sha256sums=('SKIP')
conflicts=('ttf-mplus-git')

package_ttf-mplus1() {
    cd "${srcdir}/MPLUS_FONTS/fonts/ttf" || return 1
    install -d "${pkgdir}/usr/share/fonts/TTF"

    for f in Mplus1-Bold.ttf Mplus1-Light.ttf Mplus1-Regular.ttf; do
        [[ -f "$f" ]] && install -m644 "$f" "${pkgdir}/usr/share/fonts/TTF/"
    done
}

package_ttf-mplus2() {
    cd "${srcdir}/MPLUS_FONTS/fonts/ttf" || return 1
    install -d "${pkgdir}/usr/share/fonts/TTF"

    for f in Mplus2-Bold.ttf Mplus2-Light.ttf Mplus2-Regular.ttf; do
        [[ -f "$f" ]] && install -m644 "$f" "${pkgdir}/usr/share/fonts/TTF/"
    done
}
