# Maintainer: VolRen <VolRencs@proton.me>

pkgname=ttf-mplus
pkgver=1.0.0
pkgrel=1
pkgdesc='Modern M+ Japanese font family'
arch=('any')
url='https://mplusfonts.github.io/'
license=('OFL-1.1')
makedepends=('git')
source=('git+https://github.com/coz-m/MPLUS_FONTS.git')
conflicts=('ttf-mplus' 'mplus-font')
provides=('ttf-mplus')
sha256sums=('SKIP')

package() {
    cd "${srcdir}/MPLUS_FONTS/fonts/ttf" || return 1

    install -d "${pkgdir}/usr/share/fonts/TTF"

    for f in Mplus2-Black.ttf Mplus2-Bold.ttf Mplus2-ExtraBold.ttf \
             Mplus2-ExtraLight.ttf Mplus2-Light.ttf Mplus2-Medium.ttf \
             Mplus2-Regular.ttf Mplus2-SemiBold.ttf Mplus2-Thin.ttf; do
        [[ -f "$f" ]] && install -m644 "$f" "${pkgdir}/usr/share/fonts/TTF/"
    done
}
