pkgname=discord
_pkgname=Discord
pkgver=1.0.136
pkgrel=1
epoch=1
pkgdesc="All-in-one voice and text chat for gamers"
arch=('x86_64')
url='https://discord.com'
license=('LicenseRef-custom')
depends=('libnotify' 'nspr' 'nss' 'gtk3' 'hicolor-icon-theme')
optdepends=('libpulse: PulseAudio support'
            'libappindicator-gtk3: Systray indicator support'
            'xdg-utils: For opening URLs and files')
source=("https://dl.discordapp.net/apps/linux/$pkgver/$pkgname-$pkgver.tar.gz"
        "LICENSE-$pkgver.html::https://discordapp.com/terms"
        "OSS-LICENSES-$pkgver.html::https://discordapp.com/licenses")
sha512sums=('c301e1f0c9ba3069a43aacf93e85df1b69a670530c613252d103cb801612eb460691c48f470d7657029d0aa58dbaf3c9269f959a75eabd48a9ae995b0519cbc3'
            '3595acdde235bca4e300730d2767aceadd31b7a9daa643fa82da9d5dca644ef2ff3d62656419ebe54d5f342a9f6fb90203ecfa0ff12fdf8fe9fdd6ae272a7556'
            '14baebc4e19dd03dffaf3967342c627f180c01cb6ab9e2845ab31f8d4d27ffe4d5770080c9c16675f4fe58fc0f865e77ecc64d93eb2340eafa2979d85e920ffb')

sha512sums[1]='SKIP'
sha512sums[2]='SKIP'

package() {
  cd $_pkgname

  install -Dm755 $pkgname "$pkgdir"/usr/bin/$pkgname
  install -Dm755 updater_bootstrap "$pkgdir"/usr/share/$pkgname/updater_bootstrap
  install -Dm644 $pkgname.desktop "$pkgdir"/usr/share/applications/$pkgname.desktop
  install -Dm644 $pkgname.png "$pkgdir"/usr/share/icons/hicolor/256x256/apps/$pkgname.png

  install -Dm644 "$srcdir"/LICENSE-$pkgver.html "$pkgdir"/usr/share/licenses/$pkgname/LICENSE.html
  install -Dm644 "$srcdir"/OSS-LICENSES-$pkgver.html "$pkgdir"/usr/share/licenses/$pkgname/OSS-LICENSES.html
}
