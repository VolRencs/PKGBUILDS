# Maintainer: VolRen <VolRencs@proton.me>

pkgbase=firefox-i18n
pkgver=145.0.1
pkgrel=1
pkgdesc="Русский языковой пакет для Firefox"
url="https://www.mozilla.org/firefox/"
arch=(any)
license=(MPL-2.0)

source=("ru.xpi::https://archive.mozilla.org/pub/firefox/releases/$pkgver/linux-x86_64/xpi/ru.xpi")
pkgname=firefox-i18n-ru

package_firefox-i18n-ru() {
  depends=("firefox>=$pkgver")
  install -Dm644 ru.xpi \
    "$pkgdir/usr/lib/firefox/browser/extensions/langpack-ru@firefox.mozilla.org.xpi"
}
sha256sums=('18588f1fba5cc40f86e71a63a48aab85bdb6d07999d63597959ed36a060b135d')
