# Maintainer: VolRen <VolRencs@proton.me>

pkgname=obs-studio
pkgver=32.1.2
pkgrel=1
epoch=1
pkgdesc="Free and open source software for video recording and live streaming"
arch=('x86_64')
url="https://obsproject.com"
license=('GPL-2.0-only')
depends=(
  'ffmpeg'
  'pipewire'
  'rnnoise'
  'pciutils'
  'mbedtls'
  'qt6-svg'
  'libxkbcommon'
)
makedepends=(
  'extra-cmake-modules'
  'ffnvcodec-headers'
  'nlohmann-json'
  'simde'
  'uthash'
  'vulkan-headers'
  'ninja'
  'git'
)
source=(
  "$pkgname::git+https://github.com/obsproject/obs-studio#tag=$pkgver"
  "0001-fix-optional-submodules.patch"
)
sha256sums=(
  '5d515107c68006319c91d24a3a661f6fc4c1a619ebbac85a567fb6f5fec1e2c4'
  'SKIP'
)

prepare() {
  sed -i 's/message(FATAL_ERROR "Required submodule .obs-browser. not available.")/if(ENABLE_BROWSER)\n        message(FATAL_ERROR "Required submodule '\''obs-browser'\'' not available.")\n      endif()/' \
    "$pkgname/plugins/CMakeLists.txt"

  sed -i 's/message(FATAL_ERROR "Required submodule .obs-websocket. not available.")/if(ENABLE_WEBSOCKET)\n    message(FATAL_ERROR "Required submodule '\''obs-websocket'\'' not available.")\n  endif()/' \
    "$pkgname/plugins/CMakeLists.txt"
}

build() {
  local cmake_options=(
    -B build
    -S $pkgname
    -G Ninja
    -DCMAKE_INSTALL_PREFIX=/usr
    -DENABLE_AJA=OFF
    -DENABLE_ALSA=OFF
    -DENABLE_BROWSER=OFF
    -DENABLE_DECKLINK=OFF
    -DENABLE_JACK=OFF
    -DENABLE_LIBFDK=OFF
    -DENABLE_NEW_MPEGTS_OUTPUT=OFF
    -DENABLE_SCRIPTING=OFF
    -DENABLE_SNDIO=OFF
    -DENABLE_V4L2=OFF
    -DENABLE_VLC=OFF
    -DENABLE_VST=OFF
    -DENABLE_WEBRTC=OFF
    -DENABLE_WEBSOCKET=OFF
    -DENABLE_QSV11=OFF
    -DOBS_VERSION_OVERRIDE="$pkgver"
    -Wno-dev
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}
package() {
  DESTDIR="$pkgdir" cmake --install build
}
