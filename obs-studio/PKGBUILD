# Maintainer: VolRen <VolRencs@proton.me>

pkgname=obs-studio
pkgver=32.1.0
pkgrel=1
epoch=1
pkgdesc="Free and open source software for video recording and live streaming"
arch=('x86_64')
url="https://obsproject.com"
license=('GPL-2.0-only')
depends=(
  'ffmpeg'
  'pipewire'
  'rnnoise'
  'pciutils'
  'mbedtls'
  'qt6-svg'
  'libxkbcommon'
)
makedepends=(
  'extra-cmake-modules'
  'ffnvcodec-headers'
  'nlohmann-json'
  'simde'
  'uthash'
  'vulkan-headers'
  'ninja'
)
source=(
  "$pkgname-$pkgver.tar.gz::https://github.com/obsproject/obs-studio/releases/download/$pkgver-rc1/OBS-Studio-$pkgver-rc1-Sources.tar.gz"
)
sha256sums=('17b44f973a0e98c4c322c2aca10d8b662c19fbbe50879c30ac805b0702e827dd')

build() {
  cmake -B build -S "$pkgname-$pkgver-rc1-sources" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DENABLE_AJA=OFF \
    -DENABLE_ALSA=OFF \
    -DENABLE_BROWSER=OFF \
    -DENABLE_DECKLINK=OFF \
    -DENABLE_JACK=OFF \
    -DENABLE_LIBFDK=OFF \
    -DENABLE_NEW_MPEGTS_OUTPUT=OFF \
    -DENABLE_SCRIPTING=OFF \
    -DENABLE_SNDIO=OFF \
    -DENABLE_V4L2=OFF \
    -DENABLE_VLC=OFF \
    -DENABLE_VST=OFF \
    -DENABLE_WEBRTC=OFF \
    -DENABLE_WEBSOCKET=OFF \
    -DENABLE_QSV11=OFF \
    -DOBS_VERSION_OVERRIDE="$pkgver" \
    -Wno-dev

  cmake --build build
}
package() {
  DESTDIR="$pkgdir" cmake --install build
}
