# Maintainer: VolRen <VolRencs@proton.me>

pkgname=obs-studio
pkgver=32.0.2
pkgrel=1
pkgdesc="Free and open source software for video recording and live streaming (minimal PipeWire build)"
arch=('x86_64')
url="https://obsproject.com"
license=('GPL2')

depends=(
  'ffmpeg'
  'pipewire'
  'rnnoise'
  'libxcomposite'
  'libxinerama'
  'libxkbcommon-x11'
  'libdatachannel'
  'pciutils'
  'mbedtls'
  'qt6-svg'
)

makedepends=(
  'cmake'
  'extra-cmake-modules'
  'ffnvcodec-headers'
  'nlohmann-json'
  'simde'
  'uthash'
  'vulkan-headers'
)

optdepends=(
  'v4l2loopback-dkms: virtual camera support'
)

source=(
  "$pkgname-$pkgver.tar.gz::https://github.com/obsproject/obs-studio/releases/download/$pkgver/OBS-Studio-$pkgver-Sources.tar.gz"
)
sha256sums=('48d744037c553eea8f9b76bf46f6dcac753e52871f49b2c1a2580757f723a1b7')

prepare() {
  cd "$pkgname-$pkgver-sources"

  sed -i 's/Qt::GuiPrivate/Qt::Gui/g' \
    frontend/cmake/os-linux.cmake \
    frontend/plugins/*/CMakeLists.txt
}

build() {
  export CXXFLAGS+=" -Wno-error=deprecated-declarations"

  cmake -B build -S "$pkgname-$pkgver-sources" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DENABLE_JACK=ON \
    -DENABLE_SNDIO=OFF \
    -DENABLE_BROWSER=OFF \
    -DENABLE_VST=OFF \
    -DENABLE_VLC=OFF \
    -DENABLE_LIBFDK=OFF \
    -DENABLE_WEBRTC=ON \
    -DENABLE_WEBSOCKET=OFF \
    -DENABLE_NEW_MPEGTS_OUTPUT=OFF \
    -DENABLE_AJA=OFF \
    \
    -DENABLE_SCRIPTING=OFF \
    -DOBS_VERSION_OVERRIDE="$pkgver" \
    -Wno-dev

  cmake --build build --target all -j$(nproc)
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
