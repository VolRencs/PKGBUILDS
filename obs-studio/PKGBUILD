# Maintainer: VolRen <VolRencs@proton.me>

pkgname=obs-studio
pkgver=32.2.1
pkgrel=2
epoch=1
pkgdesc="Free and open source software for video recording and live streaming"
arch=('x86_64')
url="https://obsproject.com"
license=('GPL-2.0-only')
depends=(
  'ffmpeg'
  'pipewire'
  'rnnoise'
  'speexdsp'
  'pciutils'
  'openssl'
  'qt6-svg'
  'libxkbcommon'
)
makedepends=(
  'extra-cmake-modules'
  'ffnvcodec-headers'
  'nlohmann-json'
  'simde'
  'uthash'
  'vulkan-headers'
  'ninja'
  'git'
)
source=(
  "$pkgname::git+https://github.com/obsproject/obs-studio#tag=$pkgver"
  "obs-openssl.patch"
)
sha256sums=(
  '5b11ccf5468654d19537db108443812db12767084eba295ee532d81c4834492a'
  'SKIP'
)

prepare() {
  sed -i 's/message(FATAL_ERROR "Required submodule .obs-browser. not available.")/if(ENABLE_BROWSER)\n        message(FATAL_ERROR "Required submodule '\''obs-browser'\'' not available.")\n      endif()/' \
    "$pkgname/plugins/CMakeLists.txt"

  sed -i 's/message(FATAL_ERROR "Required submodule .obs-websocket. not available.")/if(ENABLE_WEBSOCKET)\n    message(FATAL_ERROR "Required submodule '\''obs-websocket'\'' not available.")\n  endif()/' \
    "$pkgname/plugins/CMakeLists.txt"

  patch -d "$pkgname" -Np1 < "$srcdir/obs-openssl.patch"
}

build() {
  local cmake_options=(
    -B build
    -S $pkgname
    -G Ninja
    -DCMAKE_INSTALL_PREFIX=/usr
    -DENABLE_AJA=OFF
    -DENABLE_ALSA=OFF
    -DENABLE_BROWSER=OFF
    -DENABLE_DECKLINK=OFF
    -DENABLE_JACK=OFF
    -DENABLE_LIBFDK=OFF
    -DENABLE_NEW_MPEGTS_OUTPUT=OFF
    -DENABLE_SCRIPTING=OFF
    -DENABLE_SNDIO=OFF
    -DENABLE_V4L2=OFF
    -DENABLE_VLC=OFF
    -DENABLE_VST=OFF
    -DENABLE_WEBRTC=OFF
    -DENABLE_WEBSOCKET=OFF
    -DENABLE_QSV11=OFF
    -DCRYPTO_BACKEND=openssl
    -DOBS_VERSION_OVERRIDE="$pkgver"
    -Wno-dev
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}
package() {
  DESTDIR="$pkgdir" cmake --install build
}
