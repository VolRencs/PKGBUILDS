# Maintainer: VolRen <VolRencs@proton.me>

pkgname=obs-studio
pkgver=32.1.1
pkgrel=2
epoch=1
pkgdesc="Free and open source software for video recording and live streaming"
arch=('x86_64')
url="https://obsproject.com"
license=('GPL-2.0-only')
depends=(
  'ffmpeg'
  'pipewire'
  'rnnoise'
  'pciutils'
  'qt6-svg'
  'libxkbcommon'
)
makedepends=(
  'extra-cmake-modules'
  'ffnvcodec-headers'
  'nlohmann-json'
  'simde'
  'uthash'
  'vulkan-headers'
  'ninja'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/obsproject/obs-studio/releases/download/$pkgver/OBS-Studio-$pkgver-Sources.tar.gz")
sha256sums=('f4c17e1aa2a00efd8729ed6cfef9308bc6a2b6c583c187d7959eaa72eb2e3676')

build() {
  cmake -B build -S "$pkgname-$pkgver-sources" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DENABLE_AJA=OFF \
    -DENABLE_ALSA=OFF \
    -DENABLE_BROWSER=OFF \
    -DENABLE_DECKLINK=OFF \
    -DENABLE_JACK=OFF \
    -DENABLE_LIBFDK=OFF \
    -DENABLE_NEW_MPEGTS_OUTPUT=OFF \
    -DENABLE_SCRIPTING=OFF \
    -DENABLE_SNDIO=OFF \
    -DENABLE_V4L2=OFF \
    -DENABLE_VLC=OFF \
    -DENABLE_VST=OFF \
    -DENABLE_WEBRTC=OFF \
    -DENABLE_WEBSOCKET=OFF \
    -DENABLE_QSV11=OFF \
    -DOBS_VERSION_OVERRIDE="$pkgver" \
    -Wno-dev

  cmake --build build
}
package() {
  DESTDIR="$pkgdir" cmake --install build
}
