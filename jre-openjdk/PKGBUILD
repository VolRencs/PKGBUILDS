# Maintainer: VolRen <VolRencs@proton.me>

pkgname=jre-openjdk
pkgbase=java-openjdk
_majorver=25
_minorver=0
_securityver=1
_updatever=8
pkgver=${_majorver}.${_minorver}.${_securityver}.u${_updatever}
pkgrel=3

arch=('x86_64')
url='https://openjdk.java.net/'
license=('LicenseRef-Java')

makedepends=(
  jdk-openjdk
  alsa-lib
  bash
  cpio
  freetype2
  gcc-libs
  giflib
  glibc
  graphviz
  harfbuzz
  lcms2
  libcups
  libelf
  libjpeg-turbo
  libnet
  libpng
  libx11
  libxext
  libxrandr
  libxrender
  libxt
  libxtst
  pandoc
  unzip
  zip
)

depends=(
  'java-runtime-common>=3'
  ca-certificates-utils
  freetype2
  gcc-libs
  glibc
  harfbuzz
  lcms2
  libfreetype.so
  libharfbuzz.so
  libjpeg.so
  libjpeg-turbo
  liblcms2.so
  libnet
  nss
  giflib
  libgif.so
  libpng
)

optdepends=(
  'alsa-lib: sound'
  'gtk3: GTK look and feel'
)

source=(
  https://github.com/openjdk/jdk${_majorver}u/archive/jdk-${_majorver}.${_minorver}.${_securityver}+${_updatever}.tar.gz
  freedesktop-java.desktop
)
sha256sums=('SKIP'
            'SKIP')

_jvmdir=/usr/lib/jvm/java-${_majorver}-openjdk

_nonheadless=(
  lib/libawt_xawt.so
  lib/libjawt.so
  lib/libjsound.so
  lib/libsplashscreen.so
)

_git_tag=jdk-${_majorver}.${_minorver}.${_securityver}+${_updatever}

build() {
  cd jdk${_majorver}u-${_git_tag}

  bash configure \
    --with-version-string="${_majorver}.${_minorver}.${_securityver}" \
    --with-stdc++lib=dynamic \
    --with-libjpeg=system \
    --with-giflib=system \
    --with-libpng=system \
    --with-lcms=system \
    --with-zlib=system \
    --with-harfbuzz=system \
    --enable-unlimited-crypto \
    --disable-warnings-as-errors \
    --with-vendor-name="Arch Linux"

  make images
}

package() {
  cd jdk${_majorver}u-${_git_tag}/build/linux-x86_64-server-release/images/jre

  install -dm755 "${pkgdir}${_jvmdir}"
  cp -a bin lib "${pkgdir}${_jvmdir}"

  for f in "${_nonheadless[@]}"; do
    install -Dm755 "$f" "${pkgdir}${_jvmdir}/$f"
  done

  install -dm755 "${pkgdir}/etc"
  cp -r conf "${pkgdir}/etc/${pkgbase}"
  ln -s /etc/${pkgbase} "${pkgdir}${_jvmdir}/conf"

  install -dm755 "${pkgdir}/usr/share/licenses"
  cp -r legal "${pkgdir}/usr/share/licenses/${pkgbase}"
  ln -s ${pkgbase} "${pkgdir}/usr/share/licenses/${pkgname}"


  rm -f "${pkgdir}${_jvmdir}/lib/security/cacerts"
  ln -sf /etc/ssl/certs/java/cacerts "${pkgdir}${_jvmdir}/lib/security/cacerts"

  install -Dm644 "${srcdir}/freedesktop-java.desktop" \
    "${pkgdir}/usr/share/applications/java-${pkgbase}.desktop"
}
