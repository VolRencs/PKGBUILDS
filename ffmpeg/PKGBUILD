pkgname=ffmpeg
pkgver=8.1.2
pkgrel=6
epoch=3
pkgdesc='Complete solution to record, convert and stream audio and video'
arch=(x86_64)
url=https://ffmpeg.org
license=(GPL-3.0-only)
depends=(
  alsa-lib
  bzip2
  dav1d
  glib2
  glibc
  libpulse
  lame
  libdrm
  libgl
  libvorbis
  libvpx
  libwebp
  libxcb
  openssl
  opus
  svt-av1
  vulkan-icd-loader
  x264
  x265
  xz
  zlib
)
makedepends=(
  clang
  ffnvcodec-headers
  git
  mesa
  nasm
  vulkan-headers
)
optdepends=(
  'nvidia-utils: Nvidia NVDEC/NVENC support'
)
provides=(
  libavdevice.so
  libavfilter.so
  libavformat.so
  libavutil.so
  libswresample.so
  libswscale.so
)
source=(
  git+https://git.ffmpeg.org/ffmpeg.git#tag=n${pkgver}
  0001-Add-av_stream_get_first_dts-for-Chromium.patch
)
b2sums=('a2b77f48a12486d07965ffa2f4ff27e04e552b7c8d2dec4a8bf847088d93a5858982636836a13ade2765c8c976ded8908633a8c2f4142e4bbd4ed430f8cc91ce'
        'e5f7b79f7731be9ee5a7280a9221fb531ac5a2d9820fc5870b68b0eabea667dfbe8f39f41c1e1763a4c84982896afaa54c81ff57847d203b70afafd726689e5d')

prepare() {
  cd ffmpeg

  # https://crbug.com/1251779
  git apply -3 ../0001-Add-av_stream_get_first_dts-for-Chromium.patch
}


build() {
  cd ffmpeg
  ./configure \
    --prefix=/usr \
    --disable-debug \
    --disable-static \
    --disable-stripping \
    --disable-sndio \
    --disable-decoder=theora \
    --disable-decoder=speex \
    --disable-sdl2 \
    --disable-ffplay \
    --disable-vdpau \
    --disable-gnutls \
    --disable-gmp \
    --disable-libass \
    --disable-ladspa \
    --disable-libsoxr \
    --disable-vaapi \
    --disable-xlib \
    --disable-libzimg \
    --disable-fontconfig \
    --disable-libfreetype \
    --disable-libfribidi \
    --disable-libharfbuzz \
    --disable-librsvg \
    --disable-libxml2 \
    --enable-cuda-llvm \
    --enable-lto \
    --enable-gpl \
    --enable-libdav1d \
    --enable-libdrm \
    --enable-libmp3lame \
    --enable-libopus \
    --enable-libpulse \
    --enable-libsvtav1 \
    --enable-libvorbis \
    --enable-libvpx \
    --enable-libwebp \
    --enable-libx264 \
    --enable-libx265 \
    --enable-libxcb \
    --enable-nvdec \
    --enable-nvenc \
    --enable-opengl \
    --enable-openssl \
    --enable-shared \
    --enable-version3 \
    --enable-vulkan
  make
}

package() {
  depends+=(
    libdav1d.so
    libvorbisenc.so
    libvorbis.so
    libvpx.so
    libx264.so
    libx265.so
  )

  make DESTDIR="${pkgdir}" -C ffmpeg install
}
