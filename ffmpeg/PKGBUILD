pkgname=ffmpeg
pkgver=8.1.1
pkgrel=1
epoch=3
pkgdesc='Complete solution to record, convert and stream audio and video'
arch=(x86_64)
url=https://ffmpeg.org
license=(GPL-3.0-only)
depends=(
  alsa-lib
  bzip2
  cairo
  dav1d
  fontconfig
  freetype2
  fribidi
  glib2
  glibc
  glslang
  harfbuzz
  libpulse
  lame
  libdrm
  libgl
  libjxl
  libplacebo
  librsvg
  libsoxr
  libva
  libvorbis
  libvpx
  libwebp
  libx11
  libxcb
  libxml2
  openjpeg2
  openssl
  opus
  svt-av1
  vulkan-icd-loader
  x264
  x265
  xz
  zimg
  zlib
)
makedepends=(
  clang
  ffnvcodec-headers
  git
  ladspa
  mesa
  nasm
  vulkan-headers
)
optdepends=(
  'ladspa: LADSPA filters'
  'nvidia-utils: Nvidia NVDEC/NVENC support'
)
provides=(
  libavdevice.so
  libavfilter.so
  libavformat.so
  libavutil.so
  libswresample.so
  libswscale.so
)
_tag=150ba6ddfabb5c433bb2fb3ee546d2a96e59066d
source=(
  git+https://git.ffmpeg.org/ffmpeg.git#tag=${_tag}
  0001-Add-av_stream_get_first_dts-for-Chromium.patch
)
b2sums=('f0725f1156a5fa34fb5ee617c0c02dd3615c91ea1fd6f94c7d622106ecaedeee0ce74d68b9965ceb6aa70ee1c539b409bc2102c3cf2309a85340af63d2a3e03e'
        'e5f7b79f7731be9ee5a7280a9221fb531ac5a2d9820fc5870b68b0eabea667dfbe8f39f41c1e1763a4c84982896afaa54c81ff57847d203b70afafd726689e5d')

prepare() {
  cd ffmpeg

  # https://crbug.com/1251779
  git apply -3 ../0001-Add-av_stream_get_first_dts-for-Chromium.patch
}

pkgver() {
  cd ffmpeg
  git describe --tags | sed 's/^n//'
}

build() {
  cd ffmpeg
  ./configure \
    --prefix=/usr \
    --disable-debug \
    --disable-static \
    --disable-stripping \
    --disable-sndio \
    --disable-decoder=theora \
    --disable-decoder=speex \
    --disable-sdl2 \
    --disable-ffplay \
    --disable-vdpau \
    --disable-gnutls \
    --disable-gmp \
    --disable-libass \
    --enable-cuda-llvm \
    --enable-lto \
    --enable-fontconfig \
    --enable-gpl \
    --enable-ladspa \
    --enable-libdav1d \
    --enable-libdrm \
    --enable-libfreetype \
    --enable-libfribidi \
    --enable-libglslang \
    --enable-libharfbuzz \
    --enable-libjxl \
    --enable-libmp3lame \
    --enable-libopenjpeg \
    --enable-libopus \
    --enable-libplacebo \
    --enable-libpulse \
    --enable-librsvg \
    --enable-libsoxr \
    --enable-libsvtav1 \
    --enable-libvorbis \
    --enable-libvpx \
    --enable-libwebp \
    --enable-libx264 \
    --enable-libx265 \
    --enable-libxcb \
    --enable-libxml2 \
    --enable-libzimg \
    --enable-nvdec \
    --enable-nvenc \
    --enable-opengl \
    --enable-openssl \
    --enable-shared \
    --enable-version3 \
    --enable-vulkan
  make
  make tools/qt-faststart
  make doc/ffmpeg.1
}

package() {
  depends+=(
    libdav1d.so
    libfreetype.so
    libharfbuzz.so
    libjxl.so
    libplacebo.so
    librsvg-2.so
    libva.so
    libva-drm.so
    libva-x11.so
    libvorbisenc.so
    libvorbis.so
    libvpx.so
    libx264.so
    libx265.so
    libzimg.so
  )

  make DESTDIR="${pkgdir}" -C ffmpeg install install-man
  install -Dm 755 ffmpeg/tools/qt-faststart "${pkgdir}"/usr/bin/
}
