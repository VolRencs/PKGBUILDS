pkgname=prismlauncher
pkgver=10.0.5
pkgrel=1
epoch=1
pkgdesc="Minecraft launcher with ability to manage multiple instances"
arch=(x86_64)
url='https://prismlauncher.org'
license=('GPL-3.0-only')
depends=(
  glibc
  java-runtime
  libgl
  qt6-base
  qt6-svg
  qt6-imageformats
  qt6-networkauth
  zlib
  hicolor-icon-theme
  tomlplusplus
  cmark
  libarchive
  qrencode
  libstdc++
  libgcc
)
makedepends=(
  cmake
  extra-cmake-modules
  git
  jdk-openjdk
  gamemode
  ninja
)
optdepends=(
  'glfw: to use system GLFW libraries'
  'openal: to use system OpenAL libraries'
  'orca: minecraft screen reader'
  'flite: minecraft voice narration'
)
source=("https://github.com/PrismLauncher/PrismLauncher/releases/download/$pkgver/PrismLauncher-$pkgver.tar.gz")
sha256sums=('2f3b71906151d12fe72888fda0ed87aad07c250561c1b0cb6c4eb0962c56b4b8')

prepare() {
    cd "PrismLauncher-$pkgver"
    sed -i 's/-target 7 -source 7/-target 8 -source 8/g' libraries/{javacheck,launcher}/CMakeLists.txt
}

build() {
  CFLAGS="${CFLAGS/-D_FORTIFY_SOURCE=3/-D_FORTIFY_SOURCE=2}"
  CXXFLAGS="${CXXFLAGS/-D_FORTIFY_SOURCE=3/-D_FORTIFY_SOURCE=2}"

  cmake -S "PrismLauncher-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="/usr" \
    -DLauncher_BUILD_PLATFORM="archlinux" \
    -DLauncher_ENABLE_JAVA_DOWNLOADER=ON 
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
