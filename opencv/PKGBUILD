pkgname=opencv
pkgver=5.0.0
pkgrel=1
epoch=1
pkgdesc='Open Source Computer Vision Library (spectacle)'
arch=(x86_64)
license=(Apache-2.0)
url='https://opencv.org/'
depends=(abseil-cpp
         gcc-libs
         glibc
         libjpeg-turbo
         libpng
         libtiff
         libwebp
         zlib)
makedepends=(cmake
             git
             ninja)
source=(git+https://github.com/opencv/opencv#tag=$pkgver)
sha256sums=('e123822b57aa5b1cec7802cb53b302ab181a32f91a61060079a65a2fc4de1efe')
options=(!lto)

build() {
  cmake -B build -S $pkgname -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_LIST=core,imgproc \
    -DWITH_TBB=OFF \
    -DBUILD_TESTS=OFF \
    -DBUILD_PERF_TESTS=OFF \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_PROTOBUF=OFF \
    -DBUILD_WITH_DEBUG_INFO=OFF \
    -DBUILD_opencv_apps=OFF \
    -DINSTALL_C_EXAMPLES=OFF \
    -DINSTALL_PYTHON_EXAMPLES=OFF \
    -DOPENCV_SKIP_PYTHON_LOADER=ON \
    -DOPENCV_GENERATE_SETUPVARS=OFF \
    -DWITH_OPENCL=OFF \
    -DWITH_OPENGL=OFF \
    -DWITH_QT=OFF \
    -DWITH_CUDA=OFF \
    -DWITH_FFMPEG=OFF \
    -DWITH_GSTREAMER=OFF \
    -DWITH_1394=OFF \
    -DWITH_HDF5=OFF \
    -DWITH_VTK=OFF \
    -DWITH_EIGEN=OFF \
    -DWITH_JPEGXL=OFF \
    -DCV_TRACE=OFF \
    -DCPU_BASELINE_DISABLE=SSE3 \
    -DCPU_BASELINE_REQUIRE=SSE2
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
