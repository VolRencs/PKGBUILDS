pkgname=opencv
pkgver=4.13.0
pkgrel=1
epoch=1
pkgdesc='Open Source Computer Vision Library (spectacle)'
arch=(x86_64)
license=(Apache-2.0)
url='https://opencv.org/'
depends=(abseil-cpp
         gcc-libs
         glibc
         libjpeg-turbo
         libpng
         libtiff
         libwebp
         tbb
         zlib)
makedepends=(cmake
             git)
source=(git+https://github.com/opencv/opencv#tag=$pkgver)
sha256sums=('efc754fc3888944007586133fc225f0136d1767020564b81e4d90f51e9d68b60')
options=(!lto)

build() {
  cmake -B build -S $pkgname \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_CXX_STANDARD=17 \
    -DBUILD_LIST=core,imgproc \
    -DWITH_TBB=ON \
    -DBUILD_TESTS=OFF \
    -DBUILD_PERF_TESTS=OFF \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_PROTOBUF=OFF \
    -DBUILD_WITH_DEBUG_INFO=OFF \
    -DINSTALL_C_EXAMPLES=OFF \
    -DINSTALL_PYTHON_EXAMPLES=OFF \
    -DOPENCV_SKIP_PYTHON_LOADER=ON \
    -DOPENCV_GENERATE_SETUPVARS=OFF \
    -DWITH_OPENCL=OFF \
    -DWITH_OPENGL=OFF \
    -DWITH_QT=OFF \
    -DWITH_CUDA=OFF \
    -DWITH_FFMPEG=OFF \
    -DWITH_GSTREAMER=OFF \
    -DWITH_1394=OFF \
    -DWITH_HDF5=OFF \
    -DWITH_VTK=OFF \
    -DWITH_EIGEN=OFF \
    -DWITH_JPEGXL=OFF \
    -CPU_BASELINE_DISABLE=SSE3 \
    -DCPU_BASELINE_REQUIRE=SSE2
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}