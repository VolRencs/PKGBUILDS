pkgname=networkmanager
pkgver=1.56.0
pkgrel=3
epoch=1
pkgdesc="Network connection manager and user applications"
url="https://networkmanager.dev/"
arch=(x86_64)
license=(LGPL-2.1-or-later GPL-2.0-or-later)
depends=(
  audit
  curl
  glib2
  glibc
  iproute2
  jansson
  libgcc
  libndp
  libpsl
  nspr
  nss
  readline
  systemd-libs
  util-linux-libs
)
optdepends=(
  'dhcpcd: alternative DHCP client'
  'dnsmasq: connection sharing'
  'firewalld: firewall support'
  'iptables: connection sharing'
  'nftables: connection sharing'
  'polkit: let non-root users control networking'
)
provides=(libnm libnm.so)
conflicts=(libnm)
replaces=(libnm)
makedepends=(
  glib2
  glib2-devel
  glibc
  libgcc
  systemd
  systemd-libs
  curl
  dhcpcd
  dnsmasq
  iproute2
  iptables
  libndp
  libpsl
  nftables
  openresolv
  audit
  nspr
  nss
  polkit
  bash
  git
  gobject-introspection
  gtk-doc
  jansson
  meson
  perl-yaml
  python-gobject
  readline
  vala
)
backup=(etc/NetworkManager/NetworkManager.conf)
source=("git+https://gitlab.freedesktop.org/NetworkManager/NetworkManager.git#tag=${pkgver/[a-z]/-&}")
b2sums=('43aee5cce5e92861f89520fbb2174ed54a89adc89d6b903b40feddf3f8ab5b0f97559a90efc83cb2919e3eca01700726b8d2f665621bcf3a491127981625e136')

prepare() {
  cd NetworkManager
}

build() {
  local meson_options=(
    -D b_lto=true
    -D dist_version="$pkgver-$pkgrel"
    -D session_tracking_consolekit=false
    -D suspend_resume=systemd
    -D modify_system=true
    -D selinux=false
    -D iwd=false
    -D wifi=false
    -D teamdctl=false
    -D nmtui=false
    -D config_plugins_default=keyfile
    -D ifupdown=false
    -D netconfig=no
    -D config_dns_rc_manager_default=symlink
    -D vapi=true
    -D docs=false
    -D tests=no
    -D more_asserts=no
    -D more_logging=false
    -D qt=false
    -D modem_manager=false
    -D bluez5=false
    -D ofono=false
    -D ppp=false
  )
  arch-meson NetworkManager build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  cd "$pkgdir"

  # Create config directories
  install -d etc/NetworkManager/{conf,dnsmasq}.d
  install -dm700 etc/NetworkManager/system-connections

  # Default config file
  install -m644 /dev/stdin etc/NetworkManager/NetworkManager.conf <<END
# Configuration file for NetworkManager.
# See "man 5 NetworkManager.conf" for details.
END

  # Connectivity check
  install -Dm644 /dev/stdin usr/lib/NetworkManager/conf.d/20-connectivity.conf <<END
[connectivity]
uri=http://ping.archlinux.org/nm-check.txt
END

  # Restore empty dir
  install -d usr/lib/NetworkManager/dispatcher.d/no-wait.d

  # Drop unpackaged OVS file
  rm -f usr/lib/systemd/system/NetworkManager.service.d/NetworkManager-ovs.conf
}
