pkgname=libpulse
pkgver=17.0+r98+gb096704c0
pkgrel=1
epoch=1
pkgdesc="PulseAudio client library"
url="https://www.freedesktop.org/wiki/Software/PulseAudio/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
makedepends=(
  dbus
  git
  glib2
  glibc
  libasyncns
  libxcb
  meson
  systemd
)
depends=(
  bash
  dbus
  glib2
  glibc
  libasyncns
  libxcb
  systemd-libs
)
optdepends=(
  'pulse-native-provider: PulseAudio backend'
)
provides=(
  libpulse-mainloop-glib.so
  libpulse-simple.so
  libpulse.so
)
conflicts=(libpulse)
backup=(etc/pulse/client.conf)

_commit=b096704c0d42c5e784deb781a07b23cfb5286a82
source=(
  "git+https://gitlab.freedesktop.org/pulseaudio/pulseaudio.git#commit=$_commit"
)
b2sums=('3b800dc84b1ccb0f1252e9c55390842d0d63c004393f3271daa7dcdcaa6b2351ca129d2a268855c57ec6c03e14bf1a571deac6c4bb89ac1e08a83cf910834490')

pkgver() {
  cd pulseaudio
  git describe --tags | sed 's/^v//;s/[^-]*-g/r&/;s/-/+/g'
}

build() {
  local meson_options=(
    -D daemon=false
    -D client=true
    -D doxygen=disabled
    -D man=false
    -D tests=disabled
    -D avahi=disabled
    -D bluez5=disabled
    -D consolekit=disabled
    -D elogind=disabled
    -D fftw=disabled
    -D gstreamer=disabled
    -D gtk=disabled
    -D gsettings=disabled
    -D jack=disabled
    -D lirc=disabled
    -D openssl=disabled
    -D orc=disabled
    -D soxr=disabled
    -D speex=disabled
    -D tcpwrap=disabled
    -D udev=disabled
    -D valgrind=disabled
    -D webrtc-aec=disabled
    -D x11=disabled
    -D pulsedsp-location='/usr/\$LIB/pulseaudio'
    -D stream-restore-clear-old-devices=true
    -D udevrulesdir=/usr/lib/udev/rules.d
  )

  arch-meson pulseaudio build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  rm -f "$pkgdir"/usr/bin/pa{cat,ctl,dsp,mon,play,rec,record}
  rm -f "$pkgdir"/usr/share/man/man1/pa*.1
  rm -rf "$pkgdir"/usr/share/bash-completion/completions/pa*
  rm -rf "$pkgdir"/usr/share/zsh/

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 \
    "$srcdir/pulseaudio/COPYING"
}
