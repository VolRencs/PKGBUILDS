# Maintainer: Ваш Ник <ваш@email.com>

pkgname=libreoffice-bin
_lo_ver=26.2.2
pkgver=${_lo_ver}
pkgrel=1
pkgdesc="LibreOffice productivity suite (binary) - Minimal package with Russian language only (DEB-based)"
arch=('x86_64')
url="https://www.libreoffice.org/"
license=('LGPL')
depends=('fontconfig' 'freetype2' 'nss' 'curl' 'dbus' 'libcups' 'glibc' 'zlib' 'libx11' 'libxext' 'libsm')
provides=('libreoffice')
conflicts=('libreoffice-fresh' 'libreoffice-still' 'libreoffice-bin')

_base_url="https://download.documentfoundation.org/libreoffice/stable/${_lo_ver}/deb/x86_64"
_pkg_main="LibreOffice_${_lo_ver}_Linux_x86-64_deb"
_pkg_lang="LibreOffice_${_lo_ver}_Linux_x86-64_deb_langpack_ru"

source=("${_base_url}/${_pkg_main}.tar.gz"
        "${_base_url}/${_pkg_lang}.tar.gz")

sha256sums=('SKIP'
            'SKIP')

package() {
    install -dm755 "$pkgdir/usr/bin"
    install -dm755 "$pkgdir/usr/share/applications"

    msg2 "Поиск и распаковка всех .deb пакетов в $srcdir..."

    find "$srcdir" -name "*.deb" | while read -r deb_file; do
        msg3 "Обработка: $(basename "$deb_file")"
        
        bsdtar -xf "$deb_file" -O data.tar.xz 2>/dev/null | tar -xJ -C "$pkgdir" 2>/dev/null || \
        bsdtar -xf "$deb_file" -O data.tar.gz 2>/dev/null | tar -xz -C "$pkgdir" 2>/dev/null
    done

    _lo_full_path=$(find "$pkgdir/opt" -maxdepth 1 -type d -name "libreoffice*" | head -n 1)
    _lo_dir_name=$(basename "$_lo_full_path")

    if [ -z "$_lo_dir_name" ]; then
        error "Директория LibreOffice в /opt не найдена. Распаковка не удалась."
        return 1
    fi

    msg2 "Настройка симлинков и ярлыков для $_lo_dir_name..."

    ln -s "/opt/${_lo_dir_name}/program/soffice" "$pkgdir/usr/bin/libreoffice"
    
    for app in base calc draw impress math writer; do
        ln -s "/opt/${_lo_dir_name}/program/s${app}" "$pkgdir/usr/bin/libreoffice-${app}"
    done

    if [ -d "$pkgdir/opt/${_lo_dir_name}/share/xdg" ]; then
        cp "$pkgdir/opt/${_lo_dir_name}/share/xdg/"*.desktop "$pkgdir/usr/share/applications/"
    fi
    
    _short_ver=$(echo "$_lo_ver" | cut -d'.' -f1,2)
    sed -i "s|Exec=libreoffice${_short_ver}|Exec=libreoffice|g" "$pkgdir/usr/share/applications/"*.desktop
}