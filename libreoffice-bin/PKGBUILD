pkgname=libreoffice-bin
pkgver=26.2.2
pkgrel=1
epoch=1
pkgdesc='LibreOffice productivity suite with Russian language support'
arch=('x86_64')
url='https://www.libreoffice.org/'
license=('LGPL-2.1-or-later')
depends=(
  'fontconfig'
  'freetype2'
  'nss'
  'curl'
  'dbus'
  'libcups'
  'glibc'
  'zlib'
  'libx11'
  'libxext'
  'libsm'
)
makedepends=('binutils')
provides=("libreoffice=${pkgver}")
conflicts=('libreoffice-fresh' 'libreoffice-still')
options=('!strip' '!emptydirs')

_base_url="https://download.documentfoundation.org/libreoffice/stable/${pkgver}/deb/x86_64"

source=(
  "LibreOffice_${pkgver}_deb.tar.gz::${_base_url}/LibreOffice_${pkgver}_Linux_x86-64_deb.tar.gz"
  "LibreOffice_${pkgver}_deb_ru.tar.gz::${_base_url}/LibreOffice_${pkgver}_Linux_x86-64_deb_langpack_ru.tar.gz"
)
sha256sums=('SKIP'
            'SKIP')

_extract_deb() {
    local tmp
    tmp=$(mktemp -d)
    ar x "$1" --output="$tmp"
    bsdtar -xf "$tmp"/data.tar.* -C "$2"
    rm -rf "$tmp"
}

package() {
    find "$srcdir" -name '*.deb' -print0 | while IFS= read -r -d '' deb; do
        _extract_deb "$deb" "$pkgdir"
    done

    local lo_dir lo_name
    lo_dir=$(find "$pkgdir/opt" -maxdepth 1 -type d -name 'libreoffice*' | head -n1)
    [[ -z "$lo_dir" ]] && { error "LibreOffice directory not found in /opt"; return 1; }
    lo_name=$(basename "$lo_dir")

    install -dm755 "$pkgdir/usr/bin"
    ln -s "/opt/${lo_name}/program/soffice" "$pkgdir/usr/bin/libreoffice"
    for app in base calc draw impress math writer; do
        ln -s "/opt/${lo_name}/program/s${app}" "$pkgdir/usr/bin/libreoffice-${app}"
    done

    local xdg_dir="$pkgdir/opt/${lo_name}/share/xdg"
    if [[ -d "$xdg_dir" ]]; then
        install -dm755 "$pkgdir/usr/share/applications"
        install -m644 "$xdg_dir"/*.desktop "$pkgdir/usr/share/applications/"
        sed -i 's|Exec=libreoffice[0-9.]*|Exec=libreoffice|g' "$pkgdir/usr/share/applications/"*.desktop
    fi
}