pkgname=libinput
pkgver=1.31.3
pkgrel=1
epoch=1
pkgdesc="Input device management and event handling library"
url="https://wayland.freedesktop.org/libinput/doc/latest/"
arch=(x86_64)
license=(MIT)
depends=(
  glibc
  libevdev
  libgcc
  systemd-libs
)
makedepends=(
  git
  glib2
  meson
  python
  python-libevdev
  python-pyudev
  python-yaml
  wayland
  wayland-protocols
)
checkdepends=(python-pytest)
source=(
  "git+https://gitlab.freedesktop.org/libinput/libinput.git#tag=$pkgver"
)
b2sums=('197f8c4d6be126e8b8a4825109dd37405a1205f80b25595c259d42606e317525aae5def846f4bb3c3cfad09ccd9d65b53d39d34127623ea6c47db6e8cfaf3188')


build() {
  local meson_options=(
    -D debug-gui=false
    -D documentation=false
    -D libwacom=false
    -D lua-plugins=disabled
    -D mtdev=false
    -D tests=false
    -D zshcompletiondir=no
  )

  arch-meson libinput build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  provides=(libinput.so)

  meson install -C build --destdir "$pkgdir"

  install -Dm644 libinput/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
