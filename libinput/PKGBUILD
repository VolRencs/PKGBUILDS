pkgname=libinput
pkgver=1.32.0
pkgrel=1
epoch=1
pkgdesc="Input device management and event handling library"
url="https://wayland.freedesktop.org/libinput/doc/latest/"
arch=(x86_64)
license=(MIT)
depends=(
  glibc
  libevdev
  libgcc
  systemd-libs
)
makedepends=(
  git
  glib2
  meson
  python
  python-libevdev
  python-pyudev
  python-yaml
  wayland
  wayland-protocols
)
checkdepends=(python-pytest)
source=(
  "git+https://gitlab.freedesktop.org/libinput/libinput.git#tag=$pkgver"
)
b2sums=('0282e8b3c5b1cd1ac68c0b5d9dba67f60c69e747d28bef5eb911e60687238b0beb7ceb2dac6cad80ad511f8eb8ee461cc58964cbbd529c57b28872ed7666dd71')


build() {
  local meson_options=(
    -D debug-gui=false
    -D documentation=false
    -D libwacom=false
    -D lua-plugins=disabled
    -D mtdev=false
    -D tests=false
    -D zshcompletiondir=no
  )

  arch-meson libinput build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  provides=(libinput.so)

  meson install -C build --destdir "$pkgdir"

  install -Dm644 libinput/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
