# Maintainer: Peter Jung <admin@ptr1337.dev>

pkgname=mysettings
pkgver=1.3.1
pkgrel=1
groups=(cachyos)
arch=('any')
license=(GPL-1.0-only)
makedepends=('coreutils' 'git')
pkgdesc='CachyOS - Settings'
source=("git+https://github.com/CachyOS/CachyOS-Settings.git#tag=$pkgver")
install="$pkgname.install"
sha256sums=('SKIP')
depends=(
  zram-generator
  inxi
  "systemd>=256"
)
optdepends=('libluv: for topmem'
            'lua-luv: for topmem'
            'power-profiles-daemon: For game-performance')
provides=('ntsync-common')
prepare() {
  cd $_gitname
}
package() {
  install -d "$pkgdir/etc"
  cp -rf "${srcdir}/CachyOS-Settings/etc" "$pkgdir"
  install -d "$pkgdir/usr"
  cp -rf "${srcdir}/CachyOS-Settings/usr" "$pkgdir"
}
