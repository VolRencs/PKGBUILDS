pkgname=modemmanager
pkgver=1.24.2
pkgrel=1
epoch=1
pkgdesc="Minimal ModemManager (Stub for wired systems)"
arch=(x86_64)
url="https://www.freedesktop.org/wiki/Software/ModemManager/"
license=(GPL-2.0-or-later)
depends=(
  glib2
  glibc
  libgcc
  libgudev
  systemd-libs
)
makedepends=(
  git
  meson
  glib2-devel
  systemd
  libxslt
)
provides=(libmm-glib)
conflicts=(libmm-glib modemmanager-docs)
replaces=(libmm-glib modemmanager-docs)

source=("git+https://gitlab.freedesktop.org/mobile-broadband/ModemManager.git#tag=${pkgver/[a-z]/-&}")
b2sums=('SKIP')

build() {
  local meson_options=(
    -D dbus_policy_dir=/usr/share/dbus-1/system.d
    -D dist_version="\"$pkgver-$pkgrel\""

    -D polkit=no
    -D mbim=false
    -D qmi=false
    -D qrtr=false

    -D plugin_qcom_soc=disabled
    -D plugin_foxconn=disabled
    -D plugin_dell=disabled

    -D plugin_generic=disabled
    -D plugin_huawei=disabled
    -D plugin_sierra=disabled
    -D plugin_novatel=disabled
    -D plugin_quectel=disabled
    -D plugin_telit=disabled
    -D plugin_ublox=disabled
    -D plugin_zte=disabled

    -D introspection=false
    -D vapi=false
    -D examples=false
    -D tests=false
    -D man=false
    -D gtk_doc=false
    -D bash_completion=false

    -D udevdir=/usr/lib/udev
    -D systemdsystemunitdir=/usr/lib/systemd/system
  )

  arch-meson ModemManager build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  # Тотальная зачистка после установки
  rm -rf "$pkgdir/usr/share/icons"
  rm -rf "$pkgdir/usr/share/ModemManager"
  rm -rf "$pkgdir/usr/share/man"
  rm -rf "$pkgdir/usr/include/ModemManager"
}